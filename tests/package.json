        "test:financial": "node -e \"import('./financial.test.js').then(m => m.testFinancialManagement())\"",
        "test:filters": "node -e \"import('./query-filters.test.js').then(m => m.testQueryFilters())\"",
        "test:admin-ext": "node -e \"import('./admin-extended.test.js').then(m => m.testAdminExtended())\"",
