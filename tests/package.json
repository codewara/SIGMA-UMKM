        "test:admin": "node -e \"import('./admin.test.js').then(m => m.testAdminEndpoints())\"",
        "test:pejabat": "node -e \"import('./pejabat.test.js').then(m => m.testPejabatEndpoints())\"",
        "test:owner": "node -e \"import('./owner.test.js').then(m => m.testOwnerEndpoints())\"",
        "test:security": "node -e \"import('./security.test.js').then(m => m.testOwnershipProtection())\"",
